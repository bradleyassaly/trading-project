# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual envs
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Local-state / scratch
replay_out.txt
nul
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Auto-generated daily reports (existing committed reports — alpha_audit_*,
# copy_trading_*, etc. — stay tracked; only the scheduled-task outputs are ignored)
reports/morning_briefing_*.md
reports/backfill_check_*.md
reports/weekly_review_*.md

# Env / secrets
.env
.env.*
!.env.live.template

# Build / packaging
build/
dist/
*.egg-info/

# Frontend deps. NOTE: this directory is currently TRACKED (~5.1k files
# are committed), and .gitignore never untracks anything - so this rule
# only suppresses the subdirectories npm regenerates on install
# (@babel/*/data, caniuse-lite/data, ...) that would otherwise show as
# untracked forever. Untracking node_modules is a separate decision.
/src/trading_platform/frontend/node_modules/

# Jupyter
.ipynb_checkpoints/

# Testing / coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.nox/
.tox/
.coverage
.coverage.*
htmlcov/

# Trading outputs.
# IMPORTANT: these are ROOT-ANCHORED (leading slash) on purpose. Bare
# patterns like "artifacts/" match at ANY depth and silently swallowed
# src/trading_platform/artifacts/ (source code) until it was
# reconstructed on 2026-07-02. Never add a bare directory name here.
/artifacts/
/artifacts_fast/
/artifacts_medium/
/results/
/backtests/
/checkpoints/
/backups/
/exports/
reports/*.json
reports/*.csv
reports/*.parquet
reports/*.html

# Data files (root data dir only; src/trading_platform/data is source code)
/data/
*.csv
*.parquet
*.feather

# Local databases
*.db
*.sqlite

# Misc local tooling
.cache/
.python-version
.act/

# Secrets � never commit (Kalshi signing key was tracked through 2026-07-07; ROTATE it)
.kalshi/
*.pem
