htmlcov/

# Trading outputs.
# IMPORTANT: these are ROOT-ANCHORED (leading slash) on purpose. Bare
# patterns like "artifacts/" match at ANY depth and silently swallowed
# src/trading_platform/artifacts/ (source code) until it was
# reconstructed on 2026-07-02. Never add a bare directory name here.
/artifacts/
/artifacts_fast/
/artifacts_medium/
/results/
/backtests/
/checkpoints/
/backups/
reports/*.json
reports/*.csv
reports/*.parquet
reports/*.html

# Data files (root data dir only; src/trading_platform/data is source code)
/data/
*.csv
*.parquet
*.feather

# Local databases
*.db
*.sqlite

# Misc local tooling
.cache/
.python-version
.act/
